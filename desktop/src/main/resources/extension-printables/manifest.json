{
  "manifest_version": 3,
  "name": "JujaMaker · Printables",
  "version": "1.2.0",
  "description": "Rellena el formulario de subida de Printables con los modelos que prepara JujaMaker y descarga los modelos nuevos de tus usuarios para JujaMaker.",
  "host_permissions": [
    "http://127.0.0.1:47812/*",
    "https://files.printables.com/*",
    "https://media.printables.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.printables.com/*"],
      "js": ["pagina.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.printables.com/*"],
      "js": ["panel.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.printables.com/*"],
      "js": ["descargas.js"],
      "run_at": "document_idle"
    }
  ]
}
